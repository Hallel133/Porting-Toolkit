<?xml version="1.0" encoding="utf-8"?>
<!-- Porting Toolkit's player for HTML5 games. Built once per computer with the
     Android SDK (aapt2, javac, d8); each export renames the package and the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.portingtoolkit.player">
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/icon"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:isGame="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name="org.portingtoolkit.player.PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
